# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build
dist/
# uploads/
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local MySQL server + data folder (binaries, database files, password): never commit
/database/

# SQLite files must never be committed again (the app uses MySQL only)
*.db
*.db.bak
*.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
