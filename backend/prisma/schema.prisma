// MySQL schema (production). schema.sqlite.prisma is the legacy SQLite schema and is kept ONLY as the
// source for src/scripts/migrateSqliteToMysql.ts. Keep model definitions in both files in sync until that migration is done.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// USERS & RBAC
model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique @db.VarChar(255)
  password_hash String
  role_id       String
  status        String    @default("ACTIVE") // ACTIVE, INACTIVE
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  role       Role       @relation(fields: [role_id], references: [id])
  audit_logs AuditLog[]

  @@index([email])
  @@index([role_id])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // SUPER_ADMIN, CONTENT_MANAGER, EDITOR
  description String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  users            User[]
  role_permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  role_permissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id            String @id @default(uuid())
  role_id       String
  permission_id String

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@map("role_permissions")
}

model AuditLog {
  id         String   @id @default(uuid())
  user_id    String?
  action     String // CREATE, UPDATE, DELETE, PUBLISH, UNPUBLISH, LOGIN, LOGOUT, PASSWORD_CHANGE
  entity     String
  entity_id  String?
  old_data   String?  @db.LongText
  new_data   String?  @db.LongText
  ip_address String?
  user_agent String?  @db.Text
  created_at DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([action])
  @@index([entity])
  @@map("audit_logs")
}

// HOTELS
model Hotel {
  id                      String    @id @default(uuid())
  name                    String    @db.VarChar(500)
  slug                    String    @unique
  short_description       String?   @db.Text
  description             String?   @db.Text
  region                  String?
  country                 String?
  state_province          String?   @db.VarChar(500)
  city                    String?
  location_area           String?   @db.VarChar(500)
  address                 String?   @db.Text
  latitude                Float?
  longitude               Float?
  hotel_type              String?   @db.VarChar(500)
  luxury_category         String?   @db.VarChar(500)
  official_website        String?   @db.Text
  booking_url             String?   @db.Text
  google_maps_url         String?   @db.Text
  best_time_to_visit      String?   @db.Text
  highlights              String?   @db.Text
  amenities               String?   @db.Text
  dining_information      String?   @db.Text
  spa_wellness            String?   @db.Text
  activities              String?   @db.Text
  why_we_recommend        String?   @db.Text
  is_featured             Boolean   @default(false)
  is_popular              Boolean   @default(false)
  is_top_hotel            Boolean   @default(false)
  top_hotel_rank          Int?
  is_india_top_50         Boolean   @default(false)
  is_international_top_50 Boolean   @default(false)
  display_order           Int       @default(0)
  status                  String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  published_at            DateTime?
  created_by              String?
  updated_by              String?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt
  deleted_at              DateTime?

  images HotelImage[]

  @@index([slug])
  @@index([status])
  @@index([region])
  @@index([country])
  @@index([city])
  @@index([is_featured])
  @@index([published_at])
  @@map("hotels")
}

model HotelImage {
  id            String   @id @default(uuid())
  hotel_id      String
  media_id      String?
  image_url     String   @db.Text
  alt_text      String?  @db.Text
  caption       String?  @db.Text
  image_type    String   @default("gallery") // cover, gallery, room, dining, spa, experience, location
  display_order Int      @default(0)
  is_primary    Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  hotel Hotel @relation(fields: [hotel_id], references: [id], onDelete: Cascade)

  @@index([hotel_id])
  @@map("hotel_images")
}

// DESTINATIONS
model Destination {
  id                           String    @id @default(uuid())
  name                         String    @db.VarChar(500)
  slug                         String    @unique
  short_description            String?   @db.Text
  description                  String?   @db.Text
  country                      String?
  state_region                 String?   @db.VarChar(500)
  city                         String?   @db.VarChar(500)
  continent                    String?   @db.VarChar(500)
  destination_type             String?   @db.VarChar(500)
  best_time_to_visit           String?   @db.Text
  ideal_duration               String?   @db.VarChar(500)
  currency                     String?   @db.VarChar(500)
  language                     String?   @db.VarChar(500)
  time_zone                    String?   @db.VarChar(500)
  categories                   String?   @db.Text
  is_featured                  Boolean   @default(false)
  is_popular                   Boolean   @default(false)
  is_india_destination         Boolean   @default(false)
  is_international_destination Boolean   @default(false)
  display_order                Int       @default(0)
  status                       String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  published_at                 DateTime?
  created_by                   String?
  updated_by                   String?
  created_at                   DateTime  @default(now())
  updated_at                   DateTime  @updatedAt
  deleted_at                   DateTime?

  images                 DestinationImage[]
  itinerary_destinations ItineraryDestination[]

  @@index([slug])
  @@index([status])
  @@index([country])
  @@index([is_featured])
  @@index([published_at])
  @@map("destinations")
}

model DestinationImage {
  id             String   @id @default(uuid())
  destination_id String
  media_id       String?
  image_url      String   @db.Text
  alt_text       String?  @db.Text
  caption        String?  @db.Text
  image_type     String   @default("gallery")
  display_order  Int      @default(0)
  is_primary     Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  destination Destination @relation(fields: [destination_id], references: [id], onDelete: Cascade)

  @@index([destination_id])
  @@map("destination_images")
}

// ITINERARIES
model Itinerary {
  id                  String    @id @default(uuid())
  title               String    @db.VarChar(500)
  name                String?   @db.VarChar(500)
  slug                String    @unique
  itinerary_code      String?
  short_description   String?   @db.Text
  overview            String?   @db.Text
  region              String?
  country             String?   @db.VarChar(500)
  category            String?
  duration            String?   @db.VarChar(500)
  tour_type           String?   @db.VarChar(500)
  package_type        String?   @db.VarChar(500)
  nights              Int       @default(1)
  days                Int       @default(1)
  min_travelers       Int       @default(1)
  max_travelers       Int       @default(10)
  price_from          Float?
  price_currency      String?   @default("INR")
  price_unit          String?   @default("per person")
  best_time           String?   @db.Text
  recommended_for     String?   @db.Text
  route               String?   @db.Text
  hero_image          String?   @db.Text
  visa_info           String?   @db.Text
  booking_info        String?   @db.Text
  is_flights_included Boolean   @default(false)
  is_featured         Boolean   @default(false)
  display_order       Int       @default(0)
  status              String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  published_at        DateTime?
  created_by          String?
  updated_by          String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  destinations ItineraryDestination[]
  days_list    ItineraryDay[]
  features     ItineraryFeature[]
  inclusions   ItineraryInclusion[]
  exclusions   ItineraryExclusion[]
  images       ItineraryImage[]
  attractions  ItineraryAttraction[]
  activities   ItineraryActivity[]
  faqs         ItineraryFAQ[]

  @@index([slug])
  @@index([status])
  @@index([region])
  @@index([category])
  @@index([is_featured])
  @@index([published_at])
  @@map("itineraries")
}

model ItineraryDestination {
  id             String @id @default(uuid())
  itinerary_id   String
  destination_id String
  display_order  Int    @default(0)

  itinerary   Itinerary   @relation(fields: [itinerary_id], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destination_id], references: [id], onDelete: Cascade)

  @@unique([itinerary_id, destination_id])
  @@map("itinerary_destinations")
}

model ItineraryDay {
  id                   String   @id @default(uuid())
  itinerary_id         String
  day_number           Int
  title                String   @db.VarChar(500)
  location             String?  @db.VarChar(500)
  description          String?  @db.Text
  morning_activities   String?  @db.Text
  afternoon_activities String?  @db.Text
  evening_activities   String?  @db.Text
  activities_text      String?  @db.Text
  attractions_text     String?  @db.Text
  meals                String?  @db.VarChar(500)
  hotel                String?  @db.VarChar(500)
  transport            String?  @db.VarChar(500)
  important_notes      String?  @db.Text
  image_url            String?  @db.Text
  media_id             String?
  display_order        Int      @default(0)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  itinerary   Itinerary             @relation(fields: [itinerary_id], references: [id], onDelete: Cascade)
  attractions ItineraryAttraction[]
  activities  ItineraryActivity[]
  images      ItineraryImage[]

  @@index([itinerary_id])
  @@map("itinerary_days")
}

model ItineraryFeature {
  id            String   @id @default(uuid())
  itinerary_id  String
  name          String   @db.VarChar(500)
  icon          String?  @db.VarChar(500)
  display_order Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  itinerary Itinerary @relation(fields: [itinerary_id], references: [id], onDelete: Cascade)

  @@index([itinerary_id])
  @@map("itinerary_features")
}

model ItineraryInclusion {
  id            String   @id @default(uuid())
  itinerary_id  String
  title         String   @db.VarChar(500)
  description   String?  @db.Text
  display_order Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  itinerary Itinerary @relation(fields: [itinerary_id], references: [id], onDelete: Cascade)

  @@index([itinerary_id])
  @@map("itinerary_inclusions")
}

model ItineraryExclusion {
  id            String   @id @default(uuid())
  itinerary_id  String
  title         String   @db.VarChar(500)
  description   String?  @db.Text
  display_order Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  itinerary Itinerary @relation(fields: [itinerary_id], references: [id], onDelete: Cascade)

  @@index([itinerary_id])
  @@map("itinerary_exclusions")
}

model ItineraryAttraction {
  id            String   @id @default(uuid())
  itinerary_id  String
  day_id        String?
  name          String   @db.VarChar(500)
  description   String?  @db.Text
  image_url     String?  @db.Text
  display_order Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  itinerary Itinerary     @relation(fields: [itinerary_id], references: [id], onDelete: Cascade)
  day       ItineraryDay? @relation(fields: [day_id], references: [id], onDelete: SetNull)

  @@index([itinerary_id])
  @@index([day_id])
  @@map("itinerary_attractions")
}

model ItineraryActivity {
  id            String   @id @default(uuid())
  itinerary_id  String
  day_id        String?
  name          String   @db.VarChar(500)
  description   String?  @db.Text
  image_url     String?  @db.Text
  display_order Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  itinerary Itinerary     @relation(fields: [itinerary_id], references: [id], onDelete: Cascade)
  day       ItineraryDay? @relation(fields: [day_id], references: [id], onDelete: SetNull)

  @@index([itinerary_id])
  @@index([day_id])
  @@map("itinerary_activities")
}

model ItineraryFAQ {
  id            String   @id @default(uuid())
  itinerary_id  String
  question      String   @db.Text
  answer        String   @db.Text
  display_order Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  itinerary Itinerary @relation(fields: [itinerary_id], references: [id], onDelete: Cascade)

  @@index([itinerary_id])
  @@map("itinerary_faqs")
}

model ItineraryImage {
  id            String   @id @default(uuid())
  itinerary_id  String
  day_id        String?
  media_id      String?
  image_url     String   @db.Text
  alt_text      String?  @db.Text
  caption       String?  @db.Text
  image_type    String   @default("gallery")
  display_order Int      @default(0)
  is_primary    Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  itinerary Itinerary     @relation(fields: [itinerary_id], references: [id], onDelete: Cascade)
  day       ItineraryDay? @relation(fields: [day_id], references: [id], onDelete: SetNull)

  @@index([itinerary_id])
  @@index([day_id])
  @@map("itinerary_images")
}

// BLOGS
model BlogCategory {
  id            String   @id @default(uuid())
  name          String   @unique
  slug          String   @unique
  description   String?  @db.Text
  display_order Int      @default(0)
  status        String   @default("ACTIVE")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  blogs Blog[]

  @@map("blog_categories")
}

model Blog {
  id            String    @id @default(uuid())
  title         String    @db.VarChar(500)
  slug          String    @unique
  excerpt       String?   @db.Text
  content       String?   @db.LongText
  category_id   String?
  author_id     String?
  author_name   String?   @db.VarChar(500)
  author_bio    String?   @db.Text
  author_image  String?   @db.Text
  reading_time  Int?      @default(5)
  is_featured   Boolean   @default(false)
  display_order Int       @default(0)
  status        String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED, SCHEDULED
  published_at  DateTime?
  scheduled_at  DateTime?
  created_by    String?
  updated_by    String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  category BlogCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  images   BlogImage[]

  @@index([slug])
  @@index([status])
  @@index([category_id])
  @@index([is_featured])
  @@index([published_at])
  @@map("blogs")
}

model BlogImage {
  id            String   @id @default(uuid())
  blog_id       String
  media_id      String?
  image_url     String   @db.Text
  alt_text      String?  @db.Text
  caption       String?  @db.Text
  display_order Int      @default(0)
  is_featured   Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  blog Blog @relation(fields: [blog_id], references: [id], onDelete: Cascade)

  @@index([blog_id])
  @@map("blog_images")
}

// MEDIA LIBRARY
model Media {
  id                String    @id @default(uuid())
  original_filename String    @db.VarChar(500)
  filename          String    @db.VarChar(255)
  url               String    @db.Text
  mime_type         String
  file_size         Int
  width             Int?
  height            Int?
  alt_text          String?   @db.Text
  caption           String?   @db.Text
  folder            String?   @default("general")
  created_by        String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  deleted_at        DateTime?

  @@index([filename])
  @@index([mime_type])
  @@map("media")
}

// CLIENTS, PAYMENTS, INVOICES & EMAILS
model Client {
  id                      String    @id @default(uuid())
  client_code             String    @unique
  salutation              String    @default("Mr.")
  first_name              String    @db.VarChar(500)
  last_name               String    @db.VarChar(500)
  email                   String    @db.VarChar(255)
  mobile                  String
  city                    String    @db.VarChar(500)
  membership_plan         String    @db.VarChar(500)
  membership_number       String?   @unique
  membership_status       String    @default("PENDING_PAYMENT") // PENDING_PAYMENT, ACTIVE, EXPIRED, CANCELLED
  membership_activated_at DateTime?
  membership_expires_at   DateTime?
  latest_payment_status   String    @default("PENDING") // SUCCESSFUL, FAILED, PENDING, CANCELLED, ABANDONED
  amount                  Float     @default(0)
  currency                String    @default("INR")
  need_gst                Boolean   @default(false)
  company_name            String?   @db.VarChar(500)
  gstin                   String?
  terms_accepted          Boolean   @default(true)
  terms_accepted_at       DateTime  @default(now())
  welcome_email_sent_at   DateTime?
  last_payment_attempt_at DateTime?
  notes                   String?   @db.Text
  password_hash           String?   @db.VarChar(255) // member-portal login (bcrypt); null until the client sets a password
  password_set_at         DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  payment_attempts PaymentAttempt[]
  invoices         Invoice[]
  email_logs       EmailLog[]
  booking_requests BookingRequest[]
  auth_tokens      ClientAuthToken[]

  @@index([email])
  @@index([mobile])
  @@index([client_code])
  @@index([membership_status])
  @@index([latest_payment_status])
  @@index([created_at])
  @@map("clients")
}

model PaymentAttempt {
  id                 String   @id @default(uuid())
  client_id          String
  gateway            String   @default("RAZORPAY")
  gateway_order_id   String?
  gateway_payment_id String?
  gateway_signature  String?
  amount             Float
  currency           String   @default("INR")
  status             String   @default("PENDING") // PENDING, SUCCESSFUL, FAILED, CANCELLED, ABANDONED
  error_code         String?
  error_description  String?  @db.Text
  payment_method     String?
  raw_response       String?  @db.Text
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  client   Client    @relation(fields: [client_id], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([client_id])
  @@index([gateway_order_id])
  @@index([gateway_payment_id])
  @@index([status])
  @@map("payment_attempts")
}

model Invoice {
  id                 String    @id @default(uuid())
  invoice_number     String    @unique
  client_id          String
  payment_attempt_id String?
  invoice_date       DateTime  @default(now())
  due_date           DateTime?
  paid_date          DateTime?
  invoice_type       String    @default("TAX_INVOICE") // TAX_INVOICE, PRO_FORMA
  status             String    @default("UNPAID") // PAID, UNPAID, CANCELLED
  membership_plan    String    @db.VarChar(500)
  plan_description   String?   @db.Text
  quantity           Int       @default(1)
  unit_price         Float
  discount           Float     @default(0)
  taxable_amount     Float
  tax_rate           Float     @default(18.0)
  tax_amount         Float
  total_amount       Float
  amount_paid        Float     @default(0)
  balance_due        Float     @default(0)
  currency           String    @default("INR")
  company_name       String?   @db.VarChar(500)
  company_gstin      String?
  seller_name        String    @default("The Luxe Yatra Worldwide Travels & Resorts Private Limited")
  seller_address     String?   @default("12th Floor, Express Towers, Nariman Point, Mumbai, Maharashtra 400021, India")
  seller_gstin       String?   @default("27AABCT8921M1ZQ")
  seller_email       String?   @default("accounts@theluxeyatra.com")
  seller_phone       String?   @default("+91 22 6985 4000")
  pdf_url            String?   @db.Text
  pdf_path           String?   @db.Text
  sent_count         Int       @default(0)
  last_sent_at       DateTime?
  created_by_user_id String?
  notes              String?   @db.Text
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  client          Client          @relation(fields: [client_id], references: [id], onDelete: Cascade)
  payment_attempt PaymentAttempt? @relation(fields: [payment_attempt_id], references: [id], onDelete: SetNull)
  email_logs      EmailLog[]

  @@index([invoice_number])
  @@index([client_id])
  @@index([status])
  @@index([invoice_date])
  @@map("invoices")
}

model EmailLog {
  id                  String   @id @default(uuid())
  client_id           String?
  invoice_id          String?
  recipient           String   @db.VarChar(255)
  template_type       String // WELCOME_PAID, MEMBERSHIP_PENDING, PAYMENT_FAILED, INVOICE_ISSUED, INVOICE_RESEND
  subject             String   @db.VarChar(500)
  status              String // SENT, FAILED
  provider_message_id String?  @db.VarChar(500)
  error_message       String?  @db.Text
  created_by_user_id  String?
  sent_at             DateTime @default(now())

  client  Client?  @relation(fields: [client_id], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoice_id], references: [id], onDelete: SetNull)

  @@index([client_id])
  @@index([invoice_id])
  @@index([recipient])
  @@index([status])
  @@map("email_logs")
}

// One-time links emailed to members so they can create (or reset) their portal password. Only the SHA-256 hash of the token is stored.
model ClientAuthToken {
  id         String    @id @default(uuid())
  client_id  String
  token_hash String    @unique @db.VarChar(64)
  purpose    String // SET_PASSWORD, RESET_PASSWORD
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  client Client @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([client_id])
  @@index([expires_at])
  @@map("client_auth_tokens")
}

// A stay enquiry submitted by a member from the portal; handled by admins in the Requests section.
model BookingRequest {
  id               String   @id @default(uuid())
  request_code     String   @unique
  client_id        String
  city             String   @db.VarChar(255)
  hotel_name       String   @db.VarChar(500)
  check_in         DateTime
  check_out        DateTime
  adults           Int      @default(2)
  children         Int      @default(0)
  rooms            Int      @default(1)
  budget           String?  @db.VarChar(255)
  contact_phone    String?  @db.VarChar(50)
  special_requests String?  @db.Text
  status           String   @default("NEW") // NEW, IN_PROGRESS, CONFIRMED, CANCELLED
  admin_notes      String?  @db.Text
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  client Client @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([client_id])
  @@index([status])
  @@index([created_at])
  @@map("booking_requests")
}
