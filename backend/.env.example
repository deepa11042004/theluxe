# Copy to .env for local development. NEVER commit the real .env (it is git-ignored); in production set these in the host panel.

PORT=5001
NODE_ENV=development

# MySQL 8.x. Format: mysql://USER:PASSWORD@HOST:3306/DB_NAME
# URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F, # -> %23, % -> %25).
# On Coolify use the INTERNAL host name of the MySQL resource (only reachable from inside the Coolify network).
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DB_NAME"

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# File uploads (production: a persistent volume path such as /data/uploads)
# UPLOADS_DIR=/data/uploads

# One-time SQLite -> MySQL data migration only (src/scripts/migrateSqliteToMysql.ts)
# SOURCE_SQLITE_PATH=/data/dev.db

# PayU (PAYU_MODE=live charges REAL cards, use test for development)
PAYU_MODE=test
PAYU_TEST_KEY=
PAYU_TEST_SALT=
PAYU_LIVE_KEY=
PAYU_LIVE_SALT=
ENABLE_TEST_PLAN=false

# SMTP (invoice / welcome emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="The Luxe Yatra" <info@example.com>

# Public website URL used in email links (set-password, member portal). Defaults to https://theluxeyatra.com in production
# and http://localhost:3001 in development.
# SITE_URL=https://theluxeyatra.com
# Where new member stay requests are announced (defaults to COMPANY_EMAIL / info@theluxeyatra.com)
# BOOKING_ALERT_EMAIL=
